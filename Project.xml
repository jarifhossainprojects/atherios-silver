<?xml version="1.0" encoding="utf-8"?><project>    <!-- 1. Application Metadata & Identifiers -->    <meta title="Atherios Silver"           package="com.atherios.silver"           version="1.0.0"           company="Atherios Games" />    <!-- 2. Window Setup & Display Properties -->    <app main="Main"          file="atherios-silver"          path="export" />    <window width="800"             height="600"             fps="60"             background="#000000"             hardware="true"             vsync="true"             resizable="false"             orientation="landscape" />    <!-- 3. Source Code Directories -->    <source path="src" />    <!-- 4. Required Haxe/OpenFL Libraries -->    <haxelib name="openfl" />    <haxelib name="lime" />    <haxelib name="flixel" />    <haxelib name="flixel-addons" />    <haxelib name="away3d" />    <!-- 5. Asset Pipeline & Resource Bundling -->    <!-- Embed graphics, textures, and UI elements -->    <assets path="assets/textures" rename="assets/textures" type="image" embed="true" />        <!-- Embed atmospheric soundtrack and sound effects -->    <assets path="assets/audio" rename="assets/audio" type="sound" embed="true" />    <assets path="assets/audio/sfx" rename="assets/audio/sfx" type="sound" embed="true" />    <!-- Embed retro pixel fonts -->    <assets path="assets/fonts" rename="assets/fonts" type="font" embed="true" />    <!-- 6. Stage3D & Graphics Configuration -->    <!-- Enable 3D hardware acceleration for Flash / Desktop targets -->    <set name="SWF_VERSION" value="11.8" />    <haxedef name="stage3d" />    <haxedef name="advanced-telemetry" if="debug" />    <!-- 7. Build Flags & Optimization Options -->    <haxedef name="FLX_NO_HEALTH" />    <haxedef name="FLX_NO_MOUSE_ADVANCED" />        <!-- Icon Settings -->    <icon path="assets/textures/icon.png" /></project>